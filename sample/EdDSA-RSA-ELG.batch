# This file is an example to demonstrate the features of gpg-batch.sh.
# Tested with GnuPG version 2.4.4
# A detailed description of the parameters can be found on the official
# website of the GnuPG project:
#   https://www.gnupg.org/documentation/manuals/gnupg-devel/Unattended-GPG-key-generation.html
#
# NOTE: This file contains TWO parameter blocks and generates TWO
# separate keys: an EdDSA key and an RSA key. Each %commit ends
# the current block and starts a new key.
#
# NOTE: In batch mode, only the first subkey of each block is
# generated by GnuPG. Additional subkeys are added by gpg-batch.sh
# via `gpg --edit-key`.

# Print text as diagnostic.
%echo Generating an OpenPGP EdDSA (algo 22) key
%echo EdDSA (Edwards-curve Digital Signature Algorithm)

Key-Type:      EdDSA
Key-Curve:     ed25519
Key-Usage:     cert

Name-Real:     EdDSA
Name-Comment:  Edwards-curve Digital Signature Algorithm
Name-Email:    test@example.com

# In batch mode, ECDH with ed25519 is accepted as-is.
# In interactive mode (gpg --edit-key), it would be silently
# replaced with cv25519.
Subkey-Type:   ECDH
Subkey-Curve:  ed25519
Subkey-Usage:  encrypt
Expire-Date:   1m

Subkey-Type:   ELG
Subkey-Length: 4096
Subkey-Usage:  Encrypt
Expire-Date:   1w

%commit

%echo Generating an OpenPGP RSA (algo 1) key
%echo RSA (Rivest, Shamir, Adleman)

Key-Type:      RSA

# Default: depends on gpgconf-list (3072 on this system)
Key-Length:    Default
Key-Usage:     Auth Cert Sign
Expire-Date:   1y

Name-Real:     RSA
Name-Comment:  Rivest, Shamir, Adleman
Name-Email:    test@example.com

Subkey-Type:   ELG
Subkey-Length: 4096
Subkey-Usage:  Encrypt
Expire-Date:   1w

%commit
%echo Done
