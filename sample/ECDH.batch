# This file is an example to demonstrate the features of gpg-batch.sh.
# Tested with GnuPG version 2.4.4
# A detailed description of the parameters can be found on the official
# website of the GnuPG project:
#   https://www.gnupg.org/documentation/manuals/gnupg-devel/Unattended-GPG-key-generation.html
#
# NOTE: This file is intended to be applied to an existing key via
# `gpg --edit-key`, not to create a new one.
#
# WARNING: In interactive mode (gpg --edit-key), GnuPG does NOT
# allow ed* curves for an encryption subkey. If ed25519 or ed448
# is specified, GnuPG silently replaces it with cv25519 or cv448
# respectively. Use cv* curves directly to make the intent explicit.

# Print text as diagnostic.
%echo Generating an OpenPGP ECDH (algo 18) subkey
%echo ECDH (Elliptic Curve Diffie-Hellman)

%echo To apply this file, run the following command:
%echo ./gpg-batch.sh --edit-key <key-ID> sample/ECDH.batch

# Set ECDH or 18
# The register does not matter
Subkey-Type:   ECDH

# Available elliptic curves for the Subkey-Type: ECDH
#   cv25519 ───────────┐
#   ed25519 ───────────┼─> ed25519 is silently replaced with
#   cv448 ─────────────┤   cv25519, ed448 with cv448
#   ed448 ─────────────┘
#   nistp256 ──────────┐
#   nistp384 ──────────┤
#   nistp521 ──────────┤
#   brainpoolP256r1 ───┼─> The register matters
#   brainpoolP384r1 ───┤
#   brainpoolP512r1 ───┤
#   secp256k1 ─────────┘
Subkey-Curve:  cv25519

# Default: encrypt [E] (sign,cert,auth - not supported)
Subkey-Usage:  encrypt

#    0 = key does not expire
# <n>  = key expires in n days
# <n>w = key expires in n weeks
# <n>m = key expires in n months
# <n>y = key expires in n years
# Default: 0
# The register does not matter.
Expire-Date:   1d

Subkey-Type:   ECDH
Subkey-Curve:  cv25519
Expire-Date:   2d

Subkey-Type:   ECDH
Subkey-Curve:  cv448
Expire-Date:   3d

Subkey-Type:   ECDH
Subkey-Curve:  nistp256
Expire-Date:   4d

Subkey-Type:   ECDH
Subkey-Curve:  nistp384
Expire-Date:   5d

Subkey-Type:   ECDH
Subkey-Curve:  nistp521
Expire-Date:   6d

Subkey-Type:   ECDH
Subkey-Curve:  brainpoolP256r1
Expire-Date:   1w

Subkey-Type:   ECDH
Subkey-Curve:  brainpoolP384r1
Expire-Date:   2w

Subkey-Type:   ECDH
Subkey-Curve:  brainpoolP512r1
Expire-Date:   1m

Subkey-Type:   ECDH
Subkey-Curve:  secp256k1
Expire-Date:   2m
