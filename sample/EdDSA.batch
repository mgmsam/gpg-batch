# This file is an example to demonstrate the features of gpg-batch.sh.
# Tested with GnuPG version 2.4.4
# A detailed description of the parameters can be found on the official
# website of the GnuPG project:
#   https://www.gnupg.org/documentation/manuals/gnupg-devel/Unattended-GPG-key-generation.html
#
# NOTE: GnuPG batch mode can generate only ONE subkey. Additional
# subkeys must be added interactively via `gpg --edit-key`.

# Print text as diagnostic.
%echo Generating an OpenPGP EdDSA (algo 22) key
%echo EdDSA (Edwards-curve Digital Signature Algorithm)

# Set EdDSA or 22
# The register does not matter
Key-Type:      EdDSA

# Available elliptic curves for the Key-Type: EdDSA
#   cv25519 ─────────────> Not supported
#   ed25519 ───────────┐
#   ed448 ─────────────┴─> The register does not matter
#   nistp256 ──────────┐
#   nistp384 ──────────┤
#   nistp521 ──────────┤
#   brainpoolP256r1 ───┼─> Not supported for EdDSA
#   brainpoolP384r1 ───┤
#   brainpoolP512r1 ───┤
#   secp256k1 ─────────┘
Key-Curve:     ed25519

# Default: sign, cert, auth [SCA] (encrypt - not supported)
# The register does not matter.
# The separator can be either a comma or a space.
Key-Usage:     Auth,Sign

Name-Real:     EdDSA
Name-Comment:  Edwards-curve Digital Signature Algorithm
Name-Email:    test@example.com

#    0 = key does not expire
# <n>  = key expires in n days
# <n>w = key expires in n weeks
# <n>m = key expires in n months
# <n>y = key expires in n years
# Default: 0
# The register does not matter.
Expire-Date:   1d

# In batch mode, only the first subkey is generated here.
# The remaining subkeys are added by gpg-batch.sh via
# `gpg --edit-key`.
Subkey-Type:   EdDSA
Subkey-Curve:  ed25519

# Default: sign,auth [SA] (cert - ignored; encrypt - not supported)
Subkey-Usage:  Auth

Subkey-Type:   EdDSA
Subkey-Curve:  ed448
Subkey-Usage:  Sign
Expire-Date:   3d
